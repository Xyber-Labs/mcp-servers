# ============================================================
# MCP YouTube Server - Environment Variables
# ============================================================
# Copy this file to .env and update with your values

# ============================================================
# Required Configuration
# ============================================================

# Apify API Token (required for transcript extraction)
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token-here

# ============================================================
# Server Configuration
# ============================================================
MCP_YOUTUBE_HOST=0.0.0.0
MCP_YOUTUBE_PORT=8111
MCP_YOUTUBE_LOGGING_LEVEL=INFO
MCP_YOUTUBE_HOT_RELOAD=false

# SQLite database file path
DB_PATH=videos.db

# ============================================================
# YouTube Service Configuration
# ============================================================
# MCP_YOUTUBE__YOUTUBE__DELAY_BETWEEN_REQUESTS=1.0
# MCP_YOUTUBE__YOUTUBE__MAX_RESULTS=10
# MCP_YOUTUBE__YOUTUBE__NUM_VIDEOS=5

# ============================================================
# x402 Payment Configuration
# ============================================================

# Enable or disable x402 payment enforcement.
MCP_YOUTUBE_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# EVM address (0x...) - used for Base, Avalanche, SKALE Base
MCP_YOUTUBE_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
#MCP_YOUTUBE_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Choose ONE of the following facilitator options:

# Option 1: PayAI Facilitator (RECOMMENDED for multi-network support)
# Supports: Base, Avalanche, SKALE Base, Solana
MCP_YOUTUBE_X402_FACILITATOR_URL="https://facilitator.payai.network"

# Option 2: x402.org Testnet Facilitator (for testing only)
# Supports: Base Sepolia, Solana Devnet
#MCP_YOUTUBE_X402_FACILITATOR_URL="https://x402.org/facilitator"

# Option 3: CDP Facilitator (Coinbase, requires API keys)
# Supports: Base, Solana
#MCP_YOUTUBE_X402_CDP_API_KEY_ID=""
#MCP_YOUTUBE_X402_CDP_API_KEY_SECRET=""

# Path to the YAML file containing the pricing configuration for all tools.
MCP_YOUTUBE_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"
