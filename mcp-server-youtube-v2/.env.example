# ============================================================
# MCP YouTube Server - Environment Variables
# ============================================================
# Copy this file to .env and update with your values

# ============================================================
# Required Configuration
# ============================================================

# Apify API Token (required for transcript extraction)
# Get your token from: https://console.apify.com/account/integrations
MCP_YOUTUBE_APIFY_TOKEN="your-apify-token-here"

# ============================================================
# Database Configuration (Optional - for caching)
# ============================================================
MCP_YOUTUBE_DB_NAME="mcp_youtube"
MCP_YOUTUBE_DB_USER="postgres"
MCP_YOUTUBE_DB_PASSWORD="postgres"
MCP_YOUTUBE_DB_HOST="localhost"
MCP_YOUTUBE_DB_PORT=5432

# ============================================================
# YouTube Service Configuration (Optional)
# ============================================================
# MCP_YOUTUBE_DELAY_BETWEEN_REQUESTS=1.0
# MCP_YOUTUBE_MAX_RESULTS=10
# MCP_YOUTUBE_NUM_VIDEOS=5
# MCP_YOUTUBE_QUERY="quantum computing basics"

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_YOUTUBE_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# You need TWO addresses: one for EVM chains, one for Solana.
# EVM address (0x...) - used for Base, Polygon, Avalanche, SKALE Base, BNB, Sei
MCP_YOUTUBE_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
MCP_YOUTUBE_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Configure payment facilitators for x402 protocol (JSON array format).
# Browse available facilitators: https://www.x402.org/ecosystem?category=facilitators&filter=facilitators
# IMPORTANT: Choose facilitators that don't require API keys for simplest setup.
#
# Multi-facilitator setup enables support for multiple blockchain networks:
# - PayAI: Supports Base, Polygon, Avalanche, SKALE Base, Sei Network, Solana
# - Unibase x402: Supports BNB Chain (BSC)
# - First facilitator supporting a chain takes precedence
MCP_YOUTUBE_X402_FACILITATOR_URLS='["https://facilitator.payai.network","https://api.x402.unibase.com/v2"]'

# Path to the YAML file containing the pricing configuration for all tools.
MCP_YOUTUBE_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# ============================================================
# Server Configuration
# ============================================================
MCP_YOUTUBE_HOST=0.0.0.0
MCP_YOUTUBE_PORT=8111
MCP_YOUTUBE_LOGGING_LEVEL=INFO
MCP_YOUTUBE_HOT_RELOAD=false
