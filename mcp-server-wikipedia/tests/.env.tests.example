# E2E Test Configuration
# Copy this file to .env.tests and fill in your values

# Server URL for E2E tests (required)
MCP_WIKIPEDIA_TEST_BASE_URL=http://localhost:8117

# Timeout for HTTP requests in seconds
MCP_WIKIPEDIA_TEST_TIMEOUT_SECONDS=60

# Private key for x402 payment tests (optional, only needed for payment tests)
# MCP_WIKIPEDIA_TEST_PRIVATE_KEY=0x...
