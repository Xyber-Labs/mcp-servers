# --- Server Settings ---
MCP_WIKIPEDIA_HOST="0.0.0.0"
MCP_WIKIPEDIA_PORT=8006
MCP_WIKIPEDIA_LOGGING_LEVEL="INFO"
MCP_WIKIPEDIA_HOT_RELOAD="false"

# --- Wikipedia API Settings ---
# See https://www.mediawiki.org/wiki/API:Etiquette for User-Agent policy
WIKIPEDIA_USER_AGENT="MyCoolMCPAgent/1.0 (https://example.com/info; user@example.com)"
WIKIPEDIA_LANGUAGE="en"

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_WIKIPEDIA_X402_PRICING_MODE=on # [on, off]

# Wallet address where you will receive payments (EVM address 0x...).
MCP_WIKIPEDIA_X402_PAYEE_EVM_ADDRESS="0x..."

# --- Facilitator Configuration ---
# Choose ONE of the following facilitator options:

# Option 1: PayAI Facilitator (RECOMMENDED for multi-network support)
# Supports: Base, Avalanche, SKALE Base, Solana
MCP_WIKIPEDIA_X402_FACILITATOR_URL="https://facilitator.payai.network"

# Option 2: x402.org Testnet Facilitator (for testing only)
# Supports: Base Sepolia, Solana Devnet
#MCP_WIKIPEDIA_X402_FACILITATOR_URL="https://x402.org/facilitator"

# Option 3: CDP Facilitator (Coinbase, requires API keys)
# Supports: Base, Solana
#MCP_WIKIPEDIA_X402_CDP_API_KEY_ID=""
#MCP_WIKIPEDIA_X402_CDP_API_KEY_SECRET=""

# Path to the YAML file containing the pricing configuration for all tools.
MCP_WIKIPEDIA_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################
