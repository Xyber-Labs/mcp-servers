# --- ArXiv Tool Configuration (Optional Defaults) ---
ARXIV_DEFAULT_MAX_RESULTS=5
ARXIV_DEFAULT_MAX_TEXT_LENGTH=5000

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_ARXIV_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# You need TWO addresses: one for EVM chains, one for Solana.
# EVM address (0x...) - used for Base, Avalanche, SKALE Base
MCP_ARXIV_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
MCP_ARXIV_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Choose ONE of the following facilitator options:

# Option 1: PayAI Facilitator (RECOMMENDED for multi-network support)
# Supports: Base, Avalanche, SKALE Base, Solana
# Docs: https://docs.payai.network/x402/introduction
MCP_ARXIV_X402_FACILITATOR_URL="https://facilitator.payai.network"

# Option 2: x402.org Testnet Facilitator (for testing only)
# Supports: Base Sepolia, Solana Devnet
#MCP_ARXIV_X402_FACILITATOR_URL="https://x402.org/facilitator"

# Option 3: CDP Facilitator (Coinbase, requires API keys)
# Supports: Base, Solana
# If CDP keys are set, they take precedence over FACILITATOR_URL
# See: https://docs.cdp.coinbase.com/x402/quickstart-for-sellers
#MCP_ARXIV_X402_CDP_API_KEY_ID=""
#MCP_ARXIV_X402_CDP_API_KEY_SECRET=""

# Path to the YAML file containing the pricing configuration for all tools.
MCP_ARXIV_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# --- ArXiv Server Settings ---
MCP_ARXIV_HOST=localhost
MCP_ARXIV_PORT=8101
MCP_ARXIV_LOGGING_LEVEL=info
MCP_ARXIV_HOT_RELOAD=false


