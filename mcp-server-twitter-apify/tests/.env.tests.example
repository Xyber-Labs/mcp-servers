# E2E Test Configuration
# Copy this file and fill in your values

# Server URL (default: http://localhost:8120)
MCP_TWITTER_TEST_BASE_URL="http://localhost:8120"

# Request timeout in seconds
MCP_TWITTER_TEST_TIMEOUT_SECONDS=120

# Private key for x402 payment tests (optional)
# Generate with: python -c "from eth_account import Account; print(Account.create().key.hex())"
# MCP_TWITTER_TEST_PRIVATE_KEY=your_private_key_here

# MCP stateless mode (default: true)
MCP_TEST_STATELESS=true
