# --- Twitter/Apify Service Specific Settings ---
APIFY_TOKEN=
APIFY_ACTOR_NAME=apidojo/twitter-scraper-lite

# Database configuration for Postgres cache (optional)
# If DB_USER, DB_PASSWORD, and DB_HOST are all set, database caching is enabled.
# Leave any of them empty to run without database caching.
DB_NAME=mcp_twitter_apify
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Optional: Cache TTL overrides (in seconds)
# CACHE_TTL_TOPIC_LATEST=900      # 15 minutes
# CACHE_TTL_TOPIC_TOP=86400       # 24 hours
# CACHE_TTL_PROFILE=1800          # 30 minutes
# CACHE_TTL_REPLIES=3600          # 1 hour

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_TWITTER_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# You need TWO addresses: one for EVM chains, one for Solana.
# EVM address (0x...) - used for Base, Avalanche, SKALE Base, BNB, ...
MCP_TWITTER_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
MCP_TWITTER_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Configure payment facilitators for x402 protocol (JSON array format).
# Browse available facilitators: https://www.x402.org/ecosystem?category=facilitators&filter=facilitators
# IMPORTANT: Choose facilitators that don't require API keys for simplest setup.
#
# Multi-facilitator setup enables support for multiple blockchain networks:
# - PayAI: Supports Base, Polygon, Avalanche, SKALE Base, Sei Network, Solana
# - Unibase x402: Supports BNB Chain (BSC)
# - First facilitator supporting a chain takes precedence
MCP_TWITTER_X402_FACILITATOR_URLS='["https://facilitator.payai.network","https://api.x402.unibase.com/v2"]'
# Path to the YAML file containing the pricing configuration for all tools.
MCP_TWITTER_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# MCP Twitter Server - App Settings
MCP_TWITTER_HOST=0.0.0.0
MCP_TWITTER_PORT=8002
MCP_TWITTER_LOGGING_LEVEL=INFO
MCP_TWITTER_HOT_RELOAD=false