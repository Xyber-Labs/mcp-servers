# --- Tavily API Configuration ---
TAVILY_API_KEY="your_tavily_api_key_here"
TOGETHER_API_KEY="your_api_key_here"
TAVILY_MAX_RESULTS=5

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_TAVILY_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# EVM address (0x...) - used for Base, Avalanche, SKALE Base
MCP_TAVILY_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
#MCP_TAVILY_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Choose ONE of the following facilitator options:

# Option 1: PayAI Facilitator (RECOMMENDED for multi-network support)
# Supports: Base, Avalanche, SKALE Base, Solana
MCP_TAVILY_X402_FACILITATOR_URL="https://facilitator.payai.network"

# Option 2: x402.org Testnet Facilitator (for testing only)
# Supports: Base Sepolia, Solana Devnet
#MCP_TAVILY_X402_FACILITATOR_URL="https://x402.org/facilitator"

# Option 3: CDP Facilitator (Coinbase, requires API keys)
# Supports: Base, Solana
#MCP_TAVILY_X402_CDP_API_KEY_ID=""
#MCP_TAVILY_X402_CDP_API_KEY_SECRET=""

# Path to the YAML file containing the pricing configuration for all tools.
MCP_TAVILY_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# --- Server Settings ---
MCP_TAVILY_HOST=0.0.0.0
MCP_TAVILY_PORT=8106
MCP_TAVILY_HOT_RELOAD=false
MCP_TAVILY_LOGGING_LEVEL=INFO
