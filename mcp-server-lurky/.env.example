# --- Lurky Service Configuration ---
LURKY_API_KEY="your_lurky_api_key_here"
LURKY_BASE_URL=https://api.lurky.app

# --- Database Settings (for caching) ---
DB_NAME=lurky_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT_RAW=5432

# Cache TTL defaults (in seconds)
CACHE_TTL_SEARCH=3600  # 1 hour
CACHE_TTL_DETAILS=86400  # 24 hours

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_LURKY_X402_PRICING_MODE=on # [on, off]

# Wallet address where you will receive payments (EVM address 0x...).
MCP_LURKY_X402_PAYEE_EVM_ADDRESS="0x..."

# --- Facilitator Configuration ---
# Choose ONE of the following facilitator options:

# Option 1: PayAI Facilitator (RECOMMENDED for multi-network support)
# Supports: Base, Avalanche, SKALE Base, Solana
MCP_LURKY_X402_FACILITATOR_URL="https://facilitator.payai.network"

# Option 2: x402.org Testnet Facilitator (for testing only)
# Supports: Base Sepolia, Solana Devnet
#MCP_LURKY_X402_FACILITATOR_URL="https://x402.org/facilitator"

# Option 3: CDP Facilitator (Coinbase, requires API keys)
# Supports: Base, Solana
#MCP_LURKY_X402_CDP_API_KEY_ID=""
#MCP_LURKY_X402_CDP_API_KEY_SECRET=""

# Path to the YAML file containing the pricing configuration for all tools.
MCP_LURKY_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# --- Server Settings ---
MCP_LURKY_HOST=0.0.0.0
MCP_LURKY_PORT=8112
MCP_LURKY_LOGGING_LEVEL=INFO
MCP_LURKY_HOT_RELOAD=false
