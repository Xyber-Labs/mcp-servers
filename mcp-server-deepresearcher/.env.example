# --- Server Settings ---
MCP_DEEP_RESEARCHER_HOST=0.0.0.0
MCP_DEEP_RESEARCHER_PORT=8119
MCP_DEEP_RESEARCHER_LOGGING_LEVEL=INFO
MCP_DEEP_RESEARCHER_HOT_RELOAD=false

# --- x402 Payment Protocol ---
MCP_DEEP_RESEARCHER_X402_PRICING_MODE=off
MCP_DEEP_RESEARCHER_X402_PAYEE_EVM_ADDRESS=
MCP_DEEP_RESEARCHER_X402_PAYEE_SOLANA_ADDRESS=
MCP_DEEP_RESEARCHER_X402_FACILITATOR_URLS='["https://facilitator.payai.network","https://api.x402.unibase.com/v2"]'
MCP_DEEP_RESEARCHER_X402_PRICING_CONFIG_PATH=tool_pricing.yaml

# --- Database (optional - reports API unavailable if not configured) ---
MCP_DEEP_RESEARCHER_DB_NAME=
MCP_DEEP_RESEARCHER_DB_USER=
MCP_DEEP_RESEARCHER_DB_PASSWORD=
MCP_DEEP_RESEARCHER_DB_HOST=
MCP_DEEP_RESEARCHER_DB_PORT=

# --- LLM Configuration (Xyber SDK SupportedModels enum values) ---
# Available models: GEMINI_2_0_FLASH, GEMINI_2_5_PRO, META_LLAMA_3_3_70B, DEEPSEEK_V3, etc.
MCP_DEEP_RESEARCHER_LLM_MAIN=GEMINI_2_0_FLASH
MCP_DEEP_RESEARCHER_LLM_SPARE=
MCP_DEEP_RESEARCHER_LLM_THINKING=
MCP_DEEP_RESEARCHER_LLM_VALIDATION=

# --- Researcher Settings ---
MCP_DEEP_RESEARCHER_MAX_WEB_RESEARCH_LOOPS=3

# --- MCP Servers (Xyber SDK format) ---
# Use nested format: MCP_SERVERS__<NAME>__URL, MCP_SERVERS__<NAME>__TRANSPORT
# For Docker: docker-compose.yml overrides with MCP_SERVERS env var
MCP_SERVERS__TAVILY__URL=http://localhost:8108/mcp/
MCP_SERVERS__TAVILY__TRANSPORT=streamable_http

MCP_SERVERS__ARXIV__URL=http://localhost:8101/mcp/
MCP_SERVERS__ARXIV__TRANSPORT=streamable_http

MCP_SERVERS__TWITTER__URL=http://localhost:8112/mcp/
MCP_SERVERS__TWITTER__TRANSPORT=streamable_http

MCP_SERVERS__YOUTUBE__URL=http://localhost:8114/mcp/
MCP_SERVERS__YOUTUBE__TRANSPORT=streamable_http

MCP_SERVERS__TELEGRAM_PARSER__URL=http://localhost:8110/mcp/
MCP_SERVERS__TELEGRAM_PARSER__TRANSPORT=streamable_http


# LLM API Keys
GOOGLE_API_KEY=
TOGETHER_API_KEY=


# Langfuse Observability (optional)
LANGFUSE_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT=deepresearch
