# E2E Test Configuration for mcp-server-together-imgen
# Copy this file to .env.tests and fill in the values

# Server URL (start server manually before running e2e tests)
MCP_TOGETHER_IMGEN_TEST_BASE_URL=http://localhost:8111

# Timeout for image generation (in seconds, increase if needed)
MCP_TOGETHER_IMGEN_TEST_TIMEOUT_SECONDS=120

# Private key for x402 payment tests (required for payment_on tests)
# MCP_TOGETHER_IMGEN_TEST_PRIVATE_KEY=0x...

# MCP testing mode (true=stateless, false=stateful sessions)
MCP_TEST_STATELESS=true
