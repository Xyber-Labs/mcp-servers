# --- Together AI Image Generation Service Specific Settings ---
TOGETHER_API_KEY="your_together_api_key_here"

# --- Model Configuration ---
# Standard image generation model (without LoRA)
NON_LORA_IMAGE_MODEL="black-forest-labs/FLUX.1-dev"
# LoRA image generation model
LORA_IMAGE_MODEL="black-forest-labs/FLUX.1-dev-lora"
# Default LoRA adapter URL (optional - if not set, lora_url must be provided per request)
# LORA_URL="https://huggingface.co/your-org/your-lora-adapter"

# --- Prompt Refinement Configuration ---
# Model used for refining prompts before image generation
REFINER_MODEL="deepseek-ai/DeepSeek-V3"

# Refinement prompt for standard (non-LoRA) image generation
# Used when refine_prompt=True on /generate endpoint
REFINE_PROMPT_STANDARD="Rewrite this prompt for FLUX image generation, maintaining the core concept but improving clarity and detail. Add lighting, background, camera angle, and style details. Output ONLY the final prompt."

# Refinement prompt for LoRA image generation
# Used when refine_prompt=True on /generate-lora endpoint
# IMPORTANT: Include character-specific details for your LoRA adapter here!
REFINE_PROMPT_LORA="<instruction>Your task is to slightly rewrite the user's prompt for LoRA image generation. The model is fine-tuned for [describe your character/style here]. Add details like: lighting, background, camera view, emotion, style, clothing. Output ONLY the final prompt, max ~100 tokens.</instruction>"

########################################################
# x402 Protocol Settings

# Enable or disable x402 payment enforcement.
MCP_TOGETHER_IMGEN_X402_PRICING_MODE=on # [on, off]

# Wallet addresses where you will receive payments.
# You need TWO addresses: one for EVM chains, one for Solana.
# EVM address (0x...) - used for Base, Avalanche, SKALE Base, BNB, Polygon, Sei Network
MCP_TOGETHER_IMGEN_X402_PAYEE_EVM_ADDRESS="0x..."
# Solana address (Base58) - used for Solana mainnet
MCP_TOGETHER_IMGEN_X402_PAYEE_SOLANA_ADDRESS="..."

# --- Facilitator Configuration ---
# Configure payment facilitators for x402 protocol (JSON array format).
# Browse available facilitators: https://www.x402.org/ecosystem?category=facilitators&filter=facilitators
# IMPORTANT: Choose facilitators that don't require API keys for simplest setup.
#
# Multi-facilitator setup enables support for multiple blockchain networks:
# - PayAI: Supports Base, Polygon, Avalanche, SKALE Base, Sei Network, Solana
# - Unibase x402: Supports BNB Chain (BSC)
# - First facilitator supporting a chain takes precedence
MCP_TOGETHER_IMGEN_X402_FACILITATOR_URLS='["https://facilitator.payai.network","https://api.x402.unibase.com/v2"]'
# Path to the YAML file containing the pricing configuration for all tools.
MCP_TOGETHER_IMGEN_X402_PRICING_CONFIG_PATH="tool_pricing.yaml"

########################################################

# MCP Together ImGen Server - App Settings
MCP_TOGETHER_IMGEN_HOST=0.0.0.0
MCP_TOGETHER_IMGEN_PORT=8113
MCP_TOGETHER_IMGEN_LOGGING_LEVEL=INFO
MCP_TOGETHER_IMGEN_HOT_RELOAD=false
